<!-- Wazuh agent on Windows: extra event channels.
     Paste into C:\Program Files (x86)\ossec-agent\ossec.conf,
     after the <localfile> block for Security. Restart-Service Wazuh. -->
<localfile>
  <location>Microsoft-Windows-Sysmon/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>
<localfile>
  <location>Microsoft-Windows-PowerShell/Operational</location>
  <log_format>eventchannel</log_format>
</localfile>
